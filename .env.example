# Settings for docker-compose.yml - copy to .env and adjust.

# Where state, logs, accounts and game files live on the host (created on first start).
# Put MBII and Jedi Academy assets in $MBIIEZ_DATA/game/MBII and $MBIIEZ_DATA/game/base.
MBIIEZ_DATA=./docker-data

# Game servers: UDP range published on the host. Each instance config's "port" must be inside it,
# and the range must be forwarded on your router.
MBIIEZ_GAME_PORTS=29070-29079

# Node API: loopback by default; set to the host's LAN IP to reach it from a proxy or another panel.
MBIIEZ_API_BIND=127.0.0.1
MBIIEZ_API_PORT=18081

# Web panel: loopback by default; put a TLS proxy in front of it or set the LAN IP.
MBIIEZ_WEB_BIND=127.0.0.1
MBIIEZ_WEB_PORT=18080

# Container names - change them to run more than one install on a host.
MBIIEZ_NODE_CONTAINER=mbiiez-node
MBIIEZ_WEB_CONTAINER=mbiiez-web

# Dedicated Docker subnet; change it if it overlaps your network.
MBIIEZ_DOCKER_SUBNET=10.78.0.0/24
