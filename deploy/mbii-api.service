[Unit]
Description=MBIIEZ API agent
After=network.target

[Service]
WorkingDirectory=/root/mbiiez
ExecStart=/opt/openjk/venv/bin/python3 /root/mbiiez/mbii.py api serve --host ${MBIIEZ_API_HOST} --port ${MBIIEZ_API_PORT}
Environment=MBIIEZ_API_HOST=127.0.0.1 MBIIEZ_API_PORT=8081
EnvironmentFile=-/etc/default/mbii-api
Environment=MBIIEZ_STATE_DIR=/var/lib/mbiiez
Restart=on-failure
UMask=0077

[Install]
WantedBy=multi-user.target
